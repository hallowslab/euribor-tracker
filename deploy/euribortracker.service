[Unit]
Description=Euribor Tracker (FastAPI)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=euribortracker
Group=euribortracker
WorkingDirectory=/opt/euribortracker
Environment=EURIBORTRACKER_DB_PATH=/var/lib/euribortracker/euribor.db
EnvironmentFile=-/etc/euribortracker/env
ExecStart=/opt/euribortracker/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

# Security hardening (moderate; app only needs to write its data dir)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/euribortracker
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target