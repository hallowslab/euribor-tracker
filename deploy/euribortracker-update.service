[Unit]
Description=Refresh Euribor data (daily)

[Service]
Type=oneshot
User=euribortracker
Group=euribortracker
WorkingDirectory=/opt/euribortracker
Environment=EURIBORTRACKER_DB_PATH=/var/lib/euribortracker/euribor.db
EnvironmentFile=-/etc/euribortracker/env
# --no-sync: do not modify the venv on a routine data refresh
ExecStart=/usr/local/bin/uv run --no-sync --project /opt/euribortracker euribortracker update

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/euribortracker
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX